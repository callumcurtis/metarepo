#!/usr/bin/env bash
#
# Activate the development environment.
#
# Usage: source tools/bin/activate
#
# This script activates all activation scripts in the hooks directory.
# Hooks are invoked with the source command.
#
# This script also sets the standard project structure variables.

# Source the bashrc file if it exists.
if [ -f ~/.bashrc ]; then
  source ~/.bashrc
fi

# Set project structure information.
source "$(dirname "${BASH_SOURCE[0]}")/../lib/standard_project_structure.sh"
set_standard_project_structure_variables

# Activate all hooks.
for hook in "${TOOLS_HOOKS_ACTIVATE_DIR}"/*.sh; do
  source "${hook}"
done
