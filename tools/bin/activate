#!/usr/bin/env bash
#
# Activate the development environment.
#
# Usage: source tools/bin/activate
#
# This script activates all activation scripts in the hooks directory.
# Hooks are invoked with the source command. During activation, the
# project structure information is available. After activation, the
# project structure information is unset.

# Set project structure information.
source "$(dirname "${BASH_SOURCE[0]}")/../lib/project_structure.sh"
set_project_structure_variables

# Activate all hooks.
for hook in "${TOOLS_HOOKS_ACTIVATE_DIR}"/*; do
  source "${hook}"
done

# Unset project structure information.
unset_project_structure_variables
