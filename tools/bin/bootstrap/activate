#!/usr/bin/env bash
#
# Bootstrap the development environment.
#
# Usage: source tools/bin/bootstrap/activate
#
# This script bootstraps the development environment in the current shell.

# Source the bashrc file if it exists.
if [ -f ~/.bashrc ]; then
  source ~/.bashrc
fi

# Activate task.
__bootstrap__task_dir="$(git rev-parse --show-toplevel)/.environment/task"
export PATH="$PATH:$__bootstrap__task_dir/bin"

# Invoke remaining activations.
eval $(task activate:all)

# Validate the environment.
if [ "$__bootstrap__task_dir" != "$TASK_DIR" ]; then
  echo "ERROR: The environment is not properly configured." >&2
  echo "    TASK_DIR(bootstrap): $__bootstrap__task_dir" >&2
  echo "    TASK_DIR(task): $TASK_DIR" >&2
fi

unset __bootstrap__task_dir
