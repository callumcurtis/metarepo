#!/usr/bin/env bash
#
# Bootstrap the development environment.
#
# Usage: tools/bootstrap/bin/install
#
# This script installs all minimal dependencies required to run the
# development environment. It is intended to be run once after cloning the
# repository.

# Import project structure information.
source $(dirname ${BASH_SOURCE[0]})/../lib/project_structure.sh
set_bootstrap_project_structure_variables

# Install task if it is not already installed.
if [ ! -f ${__BOOTSTRAP__TASK_DIR}/bin/task ]; then
  echo "Installing task to ${__BOOTSTRAP__TASK_DIR}/bin/task"
  sh -c "$(curl --location https://taskfile.dev/install.sh)" -- -d -b ${__BOOTSTRAP__TASK_DIR}/bin
fi

unset_bootstrap_project_structure_variables
