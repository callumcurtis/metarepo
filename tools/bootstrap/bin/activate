#!/usr/bin/env bash
#
# Bootstrap the development environment.
#
# Usage: source tools/bootstrap/bin/activate
#
# This script bootstraps the development environment in the current shell.

# Source the bashrc file if it exists.
if [ -f ~/.bashrc ]; then
  source ~/.bashrc
fi

# Set project structure information for bootstrapping.
source $(dirname ${BASH_SOURCE[0]})/../lib/project_structure.sh
set_bootstrap_project_structure_variables

# Activate task.
export PATH=$PATH:$__BOOTSTRAP__TASK_DIR/bin

# Unset project structure information for bootstrapping.
unset_bootstrap_project_structure_variables
